+std::mutex g_schemeMutex;
+std::vector<std::pair<std::string, SchemeOpener>> g_schemes;
+
+SchemeOpener find_scheme_opener(std::string_view location) {
+    const auto separator = location.find("://");
+    if (separator == std::string_view::npos || separator == 0) {
+        return nullptr;
+    }
+    const std::string_view scheme = location.substr(0, separator);
+    std::lock_guard lock{g_schemeMutex};
+    for (const auto& [name, opener] : g_schemes) {
+        if (name == scheme) {
+            return opener;
+        }
+    }
+    return nullptr;
+}
+
