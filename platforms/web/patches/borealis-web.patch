+void register_scheme(std::string_view scheme, SchemeOpener opener) {
+    std::lock_guard lock{g_schemeMutex};
+    for (auto& [name, existing] : g_schemes) {
+        if (name == scheme) {
+            existing = opener;
+            return;
+        }
+    }
+    g_schemes.emplace_back(std::string{scheme}, opener);
+}
+
