     if (location.empty()) {
         return failed_open(Status::NotFound, "Location is empty");
     }
+    if (const SchemeOpener opener = find_scheme_opener(location)) {
+        if (mode != File::Mode::Read) {
+            return failed_open(Status::Unsupported, "Location is read-only");
+        }
+        SDL_IOStream* handle = opener(location);
+        if (handle == nullptr) {
+            return failed_open(Status::NotFound, "Failed to open location");
+        }
+        return {.status = Status::Ok, .file = File{handle, nullptr, false}};
+    }
 
     std::string resolved{location};
     void* access = nullptr;
@@ -448,6 +490,9 @@ Status check(std::string_view location) {
         return detail::android_check(location);
     }
 #endif
+    if (find_scheme_opener(location) != nullptr) {
+        return Status::Ok;
+    }
