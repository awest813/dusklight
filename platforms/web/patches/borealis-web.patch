@@ -0,0 +1,172 @@
+// File selection in a browser (Emscripten builds with JSPI).
+//
+// Opening suspends the calling stack while the page asks the player for files, copies the chosen
+// files into a temporary directory of the in-memory filesystem, and completes with their paths.
+// Browsers only show a file chooser shortly after a click or key press (not a gamepad button), so
+// a page can provide globalThis.borealisFileSelect.open({accept, multiple}) -> Promise<File[]> to
+// ask for a click when that happens; without it, such a request fails. Exporting downloads a copy
+// of the file (or hands it to globalThis.borealisFileSelect.save(name, blob)). Folders cannot be
+// chosen.
+#include "borealis/file_select.hpp"
+
+#include "borealis/io.hpp"
+
+#include "../io_internal.hpp"
+#include "file_select_internal.hpp"
+
+#include <emscripten/emscripten.h>
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <system_error>
+#include <vector>
+
+// Returns the number of files chosen (0 when canceled, -1 on failure), kept in
+// Module.borealisChosenFiles until borealis_web_take_file has copied each of them.
+EM_ASYNC_JS(int, borealis_web_choose_files, (const char* acceptPtr, int multiple), {
+    const options = {accept: UTF8ToString(acceptPtr), multiple: !!multiple};
+    const open = globalThis.borealisFileSelect?.open ?? ((options) => {
+        const input = Object.assign(document.createElement('input'), {type: 'file', ...options});
+        const chosen = new Promise((resolve) => {
+            input.addEventListener('change', () => resolve([...input.files]), {once: true});
+            input.addEventListener('cancel', () => resolve([]), {once: true});
+        });
+        input.showPicker(); // throws NotAllowedError without a recent click or key press
+        return chosen;
+    });
+    try {
+        const files = await open(options);
+        Module.borealisChosenFiles = await Promise.all(
+            files.map(async (file) => ({name: file.name, bytes: new Uint8Array(await file.arrayBuffer())})));
+        return Module.borealisChosenFiles.length;
+    } catch (e) {
+        err(`borealis: file selection failed: ${e}`);
+        return -1;
+    }
+});
+
+// Copies chosen file `index` into a new allocation (*data, freed by the caller) and returns its
+// name (also freed by the caller). (Pointers arrive as signed numbers; `>>> 0` keeps those above
+// 2 GiB valid.)
+EM_JS(char*, borealis_web_take_file, (int index, void** data, double* size), {
+    const file = Module.borealisChosenFiles[index];
+    const pointer = _malloc(Math.max(1, file.bytes.length)) >>> 0;
+    HEAPU8.set(file.bytes, pointer);
+    HEAPU32[data >>> 2] = pointer;
+    HEAPF64[size >>> 3] = file.bytes.length;
+    Module.borealisChosenFiles[index] = null;
+    return stringToNewUTF8(file.name);
+});
+
+EM_JS(void, borealis_web_release_files, (), { delete Module.borealisChosenFiles; });
+
+EM_JS(void, borealis_web_save_file, (const char* namePtr, const void* data, double size), {
+    data >>>= 0;
+    // slice(): a Blob cannot be made from the module's shared memory.
+    const blob = new Blob([HEAPU8.slice(data, data + size)]);
+    const name = UTF8ToString(namePtr);
+    if (globalThis.borealisFileSelect?.save) {
+        globalThis.borealisFileSelect.save(name, blob);
+        return;
+    }
+    const link = Object.assign(document.createElement('a'), {href: URL.createObjectURL(blob), download: name});
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(link.href), 60000);
+});
+
+namespace borealis::file_select::detail {
+namespace {
+
+// "gci;raw" -> ".gci,.raw"; "*" accepts anything.
+std::string accept_attribute(const std::vector<Filter>& filters) {
+    std::string accept;
+    for (const auto& filter : filters) {
+        size_t start = 0;
+        while (start <= filter.pattern.size()) {
+            size_t end = filter.pattern.find(';', start);
+            if (end == std::string::npos) {
+                end = filter.pattern.size();
+            }
+            const std::string extension = filter.pattern.substr(start, end - start);
+            if (extension == "*") {
+                return {};
+            }
+            if (!extension.empty()) {
+                accept += accept.empty() ? "." : ",.";
+                accept += extension;
+            }
+            start = end + 1;
+        }
+    }
+    return accept;
+}
+
+// Chosen files stay until the next selection: callers may read them after their callback returns.
+const std::filesystem::path ImportDirectory = "/tmp/borealis-file-select";
+
+}  // namespace
+
+void open_web_file(FileOptions options, Callback callback) {
+    const int count = borealis_web_choose_files(
+        accept_attribute(options.filters).c_str(), options.multiSelect ? 1 : 0);
+    if (count < 0) {
+        complete(std::move(callback),
+            {.status = Status::Failed, .message = "The browser did not open its file chooser"});
+        return;
+    }
+
+    std::error_code ec;
+    std::filesystem::remove_all(ImportDirectory, ec);
+    std::filesystem::create_directories(ImportDirectory, ec);
+    Result result{.status = count == 0 ? Status::Canceled : Status::Selected};
+    for (int i = 0; i < count; ++i) {
+        void* data = nullptr;
+        double size = 0;
+        char* name = borealis_web_take_file(i, &data, &size);
+        std::string fileName{name};
+        std::free(name);
+        if (!io::detail::safe_child_name(fileName)) {
+            fileName = "file-" + std::to_string(i);
+        }
+        const auto path = ImportDirectory / std::to_string(i) / fileName;
+        std::filesystem::create_directories(path.parent_path(), ec);
+        std::ofstream out{path, std::ios::binary | std::ios::trunc};
+        out.write(static_cast<const char*>(data), static_cast<std::streamsize>(size));
+        out.close();
+        std::free(data);
+        if (!out.good()) {
+            result = {.status = Status::Failed, .message = "Unable to store the chosen file"};
+            break;
+        }
+        result.locations.push_back(io::fs_path_to_string(path));
+    }
+    borealis_web_release_files();
+    complete(std::move(callback), std::move(result));
+}
+
+void export_web_file(ExportOptions options, Callback callback) {
+    auto input = io::open(options.sourceLocation, io::File::Mode::Read);
+    if (input.status != io::Status::Ok) {
+        complete(std::move(callback),
+            {.status = Status::Failed,
+                .message = input.message.empty() ? "Unable to open export source" : input.message});
+        return;
+    }
+    std::vector<std::byte> bytes;
+    std::byte buffer[64 * 1024];
+    while (const uint64_t read = input.file.read(buffer, sizeof(buffer))) {
+        bytes.insert(bytes.end(), buffer, buffer + read);
+    }
+    if (!input.file.error().empty()) {
+        complete(std::move(callback), {.status = Status::Failed, .message = input.file.error()});
+        return;
+    }
+    borealis_web_save_file(
+        options.suggestedName.c_str(), bytes.data(), static_cast<double>(bytes.size()));
+    // The browser saves it where the player's downloads go; there is no location to report.
+    complete(std::move(callback), {.status = Status::Selected});
+}
+
+}  // namespace borealis::file_select::detail
