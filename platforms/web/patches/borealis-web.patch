+TEST(IOSchemeTest, RegisteredSchemeOpensReadOnlyStreams) {
+    borealis::io::register_scheme("borealistest", [](std::string_view location) -> SDL_IOStream* {
+        static constexpr char kData[] = "hello";
+        return location == "borealistest://hello" ? SDL_IOFromConstMem(kData, 5) : nullptr;
+    });
+
+    EXPECT_EQ(borealis::io::check("borealistest://hello"), borealis::io::Status::Ok);
+    auto opened = borealis::io::open("borealistest://hello");
+    ASSERT_EQ(opened.status, borealis::io::Status::Ok) << opened.message;
+    EXPECT_FALSE(opened.file.writable());
+    EXPECT_EQ(opened.file.size(), 5u);
+
+    EXPECT_EQ(borealis::io::open("borealistest://missing").status, borealis::io::Status::NotFound);
+    EXPECT_EQ(borealis::io::open("borealistest://hello", borealis::io::File::Mode::Truncate).status,
+        borealis::io::Status::Unsupported);
+    EXPECT_EQ(borealis::io::check("unregistered://x"), borealis::io::Status::Unsupported);
+}
